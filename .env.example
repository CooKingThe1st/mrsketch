# Environment configuration for MR-Sketch Deployment (Coolify / Docker)

# Redis connection URL for Admin Sync Engine
# In Coolify internal network: e.g. redis://default:<password>@<redis-container-name>:6379/0
REDIS_URL=redis://localhost:6379/0

# Secret passphrase required in x-admin-secret header for Push / Pull endpoints
ADMIN_SECRET=your_secure_admin_passcode_here
